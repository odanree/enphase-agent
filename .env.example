ENPHASE_EMAIL=you@example.com
ENPHASE_PASSWORD=changeme
ENPHASE_GATEWAY_HOST=192.168.1.100
ENPHASE_SERIAL=122001001234
# Grafana admin login — change before exposing beyond the LAN.
GF_SECURITY_ADMIN_PASSWORD=change_me
# SQLite audit ledger. Inside the container this is the named-volume path
# (compose sets it too); leave unset for local dev and it falls back to
# ./enphase.db in the project root (gitignored).
ENPHASE_DB_PATH=/data/enphase.db
